# scraperhryt ortam ayarları.  Kopyalayın:  cp .env.example .env
#
# Değişken adları src/scraperhryt/config.py içindeki Settings alanlarıyla birebir eşleşir (büyük/küçük harf
# duyarsız). Aynı dosya hem `docker compose` (env_file + ${...} yerine koyma) hem de yerel çalıştırmada
# (pydantic-settings proje kökündeki .env'i okur) kullanılır.
#
# Varsayılanlar docker compose'a göredir. Uygulamayı Docker DIŞINDA (venv ile) çalıştırıyorsanız
# "yerel" satırlarını açın: RabbitMQ/Elasticsearch/Ollama localhost üzerinden erişilir.

# ---- Genel ----
LOG_LEVEL=INFO
ENVIRONMENT=dev

# ---- RabbitMQ ----
# compose içinde (servis adı; compose bu değeri zaten zorlar):
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
# yerel çalıştırma:
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
RABBITMQ_EXCHANGE=news.topic
RABBITMQ_DLX=news.dlx
RABBITMQ_PREFETCH=8
RABBITMQ_MAX_ATTEMPTS=5
RABBITMQ_RETRY_DELAY_MS=15000
RABBITMQ_HEARTBEAT=60

# ---- Elasticsearch ----
# compose içinde (compose bu değeri zaten zorlar):
ELASTICSEARCH_URL=http://elasticsearch:9200
# yerel çalıştırma:
# ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ES_INDEX_ARTICLES=news-articles
ES_INDEX_ALARMS=news-alarms
ES_INDEX_REPORTS=news-reports
ES_REQUEST_TIMEOUT=30

# ---- Ollama / LLM ----
# Varsayılan kurulumda Ollama ANA MAKİNEDE çalışır; konteynerler ona host.docker.internal üzerinden ulaşır
# (compose, uygulama servislerine extra_hosts: host.docker.internal:host-gateway ekler).
# DİKKAT: Ollama varsayılan olarak yalnızca 127.0.0.1:11434'e bağlanır ve bu adres konteynerlerden (özellikle
# Linux'ta Docker Engine ile) ERİŞİLEMEZ. Ana makinedeki Ollama'yı tüm arayüzlerde dinleyecek biçimde başlatın:
#     OLLAMA_HOST=0.0.0.0 ollama serve        (systemd: `systemctl edit ollama` → Environment="OLLAMA_HOST=0.0.0.0")
#   - Ollama'yı konteynerde çalıştırıyorsanız (`docker compose --profile ollama up -d`): http://ollama:11434
#   - Docker dışında yerel çalıştırma:                                                 http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_BASE_URL=http://localhost:11434
# `setup` servisi (ve `scraperhryt setup` / `check`) Ollama'ya erişemez ya da OLLAMA_MODEL yüklü değilse HATA ile
# çıkar; compose yığını başlamaz (aksi halde skorlayıcı anahtar kelime eşleşen her haberi ölü mektuba düşürürdü).
# Ollama'sız (ör. --fake-llm) kurulum için 1 yapın: Ollama sorunu yalnızca uyarı olur (compose bu değişkeni
# konteynere geçirir; venv ile yerel çalıştırmada `scraperhryt setup --ollama-optional` bayrağını kullanın).
OLLAMA_OPTIONAL=0
# `setup` Ollama sunucusu + OLLAMA_MODEL hazır olana dek en çok bu kadar saniye bekler (0 = beklemez, hemen HATA).
# `docker compose --profile ollama up -d` İLK açılışta modeli dakikalarca indirir ve `setup` indirmeyi beklemez;
# ya burada 900 gibi bir değer verin ya da `make up-ollama` kullanın (önce indirir, sonra yığını başlatır).
# Yerelde: `scraperhryt setup --ollama-wait SN`.
OLLAMA_WAIT_SECONDS=0
# compose: scorer/reporter/api konteynerlerine SIGTERM sonrası SIGKILL'den önce tanınan süre (stop_grace_period).
# Süren bir LLM çağrısının (OLLAMA_TIMEOUT'a kadar) bitip mesajın onaylanması için OLLAMA_TIMEOUT'tan büyük tutun.
LLM_STOP_GRACE=200s
OLLAMA_MODEL=qwen2.5:7b
# Boş ise yalnızca BM25 arama; dolu ise (ör. nomic-embed-text) haberler için vektör üretilir ve RAG kNN kullanır.
OLLAMA_EMBEDDING_MODEL=
EMBEDDING_DIMS=768
OLLAMA_TIMEOUT=180
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_CONTENT_CHARS=6000

# ---- Anahtar kelime filtresi ----
# Virgülle ayrılmış. Varsayılan eşleşme Türkçe ek-toleranslı köktür (bakan → bakanı, bakanlık, bakanlar ...).
# "=kelime" tam eşleşme, "~parça" alt dize, "re:..." düzenli ifade.
KEYWORDS=bakan,cumhurbaşkanı,fon
# LLM skoru bu eşiğin üstünde/eşit ise alarm üretilir (0-100).
ALARM_THRESHOLD=60
# true ise anahtar kelime içermeyen haberler de LLM'e gönderilir (daha pahalı).
LLM_SCORE_ALL=false

# ---- Scraper ----
SOURCES=hurriyet,12punto
SCRAPE_INTERVAL_SECONDS=300
REQUEST_TIMEOUT=25
REQUEST_DELAY_SECONDS=0.5
# İstek User-Agent başlığı (sitelerin tarayıcı dışı istemcileri engellememesi için tarayıcı benzeri).
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 scraperhryt/0.1
# compose içinde /app/data/... olarak zorlanır; yerelde proje kökündeki data/ dizini kullanılır.
STATE_DB_PATH=data/state.sqlite3
# >0 ise 12punto arşiv aramasıyla geriye dönük tarama (Hürriyet arşivi robots.txt gereği taranmaz).
BACKFILL_DAYS=0
# Tur başına toplam sayfa çekme bütçesi; kaynaklar arasında adil paylaşılır (kullanılmayan pay devreder)
MAX_ARTICLES_PER_RUN=400
HURRIYET_GUNDEM_RSS=https://www.hurriyet.com.tr/rss/gundem
HURRIYET_GUNDEM_LISTING=https://www.hurriyet.com.tr/gundem/
PUNTO_BASE_URL=https://12punto.com.tr
PUNTO_CATEGORIES=gundem,siyaset,dunya,ekonomi,yasam,spor,bilim-teknoloji,kulis,medya,adalet-hukuk,yerel-haberler,kultur-sanat,saglik,egitim,cevre,turkiye,kamu-gundemi,is-dunyasi,secim,otomotiv,seyahat,gurme,trend-bilgi-kapsulu

# ---- Alarm katmanı ----
# Genel JSON webhook (Slack/Discord/Mattermost uyumlu "text" alanı da gönderilir). Boş ise kapalı.
ALARM_WEBHOOK_URL=
# Telegram: ikisi birlikte verilmelidir. Boş ise kapalı.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Her alarm ayrıca JSONL olarak bu dosyaya eklenir (compose içinde /app/data/alarms.jsonl).
ALARM_LOG_PATH=data/alarms.jsonl

# ---- Raporlama / API ----
API_HOST=0.0.0.0
API_PORT=8000
REPORT_INTERVAL_MINUTES=60
REPORT_WINDOW_HOURS=24
# q.alarms'tan bu kadar alarm birikince ... veya son özetten bu kadar dakika geçince alarm özeti raporu üret.
REPORT_DIGEST_EVERY=10
REPORT_DIGEST_MINUTES=30
RAG_TOP_K=12
RAG_RECENCY_DAYS=14
# Soru-cevap süre sınırları (sn): Ollama skorlayıcıyla paylaşılır; sınır aşılırsa yanıt haber metninden derlenir.
RAG_REWRITE_TIMEOUT=20
RAG_ANSWER_TIMEOUT=90

# ---- Doğruluk geliştirmeleri (bkz. docs/ARCHITECTURE.md) ----
# Hürriyet gündem listesinde Playwright ile JS sayfalama/"daha fazla" derin taraması (0 = kapalı; pip install .[deep]).
HURRIYET_DEEP_PAGES=0
DEEP_CRAWL_TIMEOUT=60
# Kanonik anahtar kelime → eş anlamlı/varlık listesi (JSON). Eşleşmeler kanonik adla kaydedilir.
KEYWORD_ALIASES_PATH=config/keyword_aliases.json
# Kaynak/kategori bazlı alarm eşikleri, JSON: {"source:12punto": 70, "category:Spor": 90}. Boş ise ALARM_THRESHOLD.
ALARM_THRESHOLDS_JSON=
# Embedding tabanlı ön sınıflandırıcı: anahtar kelime eşleşen ama ilgisiz (örn. fiil olan "bakan") haberleri LLM'den önce eler.
PRECLASSIFIER_ENABLED=false
# relevance = cos(ilgili) - cos(ilgisiz); tipik aralık ±0.05. -0.02 = yalnızca açıkça ilgisizse ele (başlıkta anahtar kelime varsa hiç elenmez).
PRECLASSIFIER_THRESHOLD=-0.02
PRECLASSIFIER_PROTOTYPES_PATH=config/preclassifier_prototypes.json
# Öz-tutarlılık: aynı haber LLM_SAMPLES kez skorlanır, medyan alınır; fark eşiği aşarsa needs_review=true.
LLM_SAMPLES=1
LLM_SAMPLE_TEMPERATURE=0.4
LLM_DISAGREEMENT_THRESHOLD=25
# Prompta altın setten eklenecek few-shot örnek sayısı ve altın set yolu (scraperhryt calibrate bu seti kullanır).
LLM_FEWSHOT_EXAMPLES=0
GOLDEN_SET_PATH=config/golden_set.jsonl
RESCORE_BATCH_SIZE=50
# Olay kümeleme: pencere içinde benzer alarm varsa duplicate_of/event_id doldurulur, bildirim bastırılır.
ALARM_DEDUP_ENABLED=true
ALARM_DEDUP_WINDOW_HOURS=24
ALARM_DEDUP_SIMILARITY=0.82
ALARM_DEDUP_TITLE_JACCARD=0.6
ALARM_NOTIFY_DUPLICATES=false
# RAG: embedding modeli ayarlıysa BM25 + kNN (RRF) birleşik arama; değerlendirme seti yolu.
RAG_HYBRID=true
RAG_EVAL_PATH=config/rag_eval.jsonl
# Ani artış tespiti: aynı konu/varlık için pencere içinde en az N alarm → burst raporu (report.burst).
BURST_WINDOW_MINUTES=60
BURST_MIN_ARTICLES=5
# Prometheus metrikleri (API: GET /metrics; tüketiciler: METRICS_PORT üzerinde exporter).
METRICS_ENABLED=true
METRICS_PORT=9108
