# scraperhryt ortam ayarları.  Kopyalayın:  cp .env.example .env
#
# Değişken adları src/scraperhryt/config.py içindeki Settings alanlarıyla birebir eşleşir (büyük/küçük harf
# duyarsız). Aynı dosya hem `docker compose` (env_file + ${...} yerine koyma) hem de yerel çalıştırmada
# (pydantic-settings proje kökündeki .env'i okur) kullanılır.
#
# Varsayılanlar docker compose'a göredir. Uygulamayı Docker DIŞINDA (venv ile) çalıştırıyorsanız
# "yerel" satırlarını açın: RabbitMQ/Elasticsearch/Ollama localhost üzerinden erişilir.

# ---- Genel ----
LOG_LEVEL=INFO
ENVIRONMENT=dev

# ---- RabbitMQ ----
# compose içinde (servis adı; compose bu değeri zaten zorlar):
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/%2F
# yerel çalıştırma:
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F
RABBITMQ_EXCHANGE=news.topic
RABBITMQ_DLX=news.dlx
RABBITMQ_PREFETCH=8
RABBITMQ_MAX_ATTEMPTS=5
RABBITMQ_RETRY_DELAY_MS=15000
RABBITMQ_HEARTBEAT=60

# ---- Elasticsearch ----
# compose içinde (compose bu değeri zaten zorlar):
ELASTICSEARCH_URL=http://elasticsearch:9200
# yerel çalıştırma:
# ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=
ES_INDEX_ARTICLES=news-articles
ES_INDEX_ALARMS=news-alarms
ES_INDEX_REPORTS=news-reports
ES_REQUEST_TIMEOUT=30

# ---- Ollama / LLM ----
# Varsayılan kurulumda Ollama ANA MAKİNEDE çalışır (`ollama serve`); konteynerler ona host.docker.internal
# üzerinden ulaşır (compose, uygulama servislerine extra_hosts: host.docker.internal:host-gateway ekler).
#   - Ollama'yı konteynerde çalıştırıyorsanız (`docker compose --profile ollama up -d`): http://ollama:11434
#   - Docker dışında yerel çalıştırma:                                                 http://localhost:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Boş ise yalnızca BM25 arama; dolu ise (ör. nomic-embed-text) haberler için vektör üretilir ve RAG kNN kullanır.
OLLAMA_EMBEDDING_MODEL=
EMBEDDING_DIMS=768
OLLAMA_TIMEOUT=180
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192
OLLAMA_MAX_CONTENT_CHARS=6000

# ---- Anahtar kelime filtresi ----
# Virgülle ayrılmış. Varsayılan eşleşme Türkçe ek-toleranslı köktür (bakan → bakanı, bakanlık, bakanlar ...).
# "=kelime" tam eşleşme, "~parça" alt dize, "re:..." düzenli ifade.
KEYWORDS=bakan,cumhurbaşkanı,fon
# LLM skoru bu eşiğin üstünde/eşit ise alarm üretilir (0-100).
ALARM_THRESHOLD=60
# true ise anahtar kelime içermeyen haberler de LLM'e gönderilir (daha pahalı).
LLM_SCORE_ALL=false

# ---- Scraper ----
SOURCES=hurriyet,12punto
SCRAPE_INTERVAL_SECONDS=300
REQUEST_TIMEOUT=25
REQUEST_DELAY_SECONDS=0.5
# İstek User-Agent başlığı (sitelerin tarayıcı dışı istemcileri engellememesi için tarayıcı benzeri).
USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36 scraperhryt/0.1
# compose içinde /app/data/... olarak zorlanır; yerelde proje kökündeki data/ dizini kullanılır.
STATE_DB_PATH=data/state.sqlite3
# >0 ise 12punto arşiv aramasıyla geriye dönük tarama (Hürriyet arşivi robots.txt gereği taranmaz).
BACKFILL_DAYS=0
# Tur başına toplam sayfa çekme bütçesi; kaynaklar arasında adil paylaşılır (kullanılmayan pay devreder)
MAX_ARTICLES_PER_RUN=400
HURRIYET_GUNDEM_RSS=https://www.hurriyet.com.tr/rss/gundem
HURRIYET_GUNDEM_LISTING=https://www.hurriyet.com.tr/gundem/
PUNTO_BASE_URL=https://12punto.com.tr
PUNTO_CATEGORIES=gundem,siyaset,dunya,ekonomi,yasam,spor,bilim-teknoloji,kulis,medya,adalet-hukuk,yerel-haberler,kultur-sanat,saglik,egitim,cevre

# ---- Alarm katmanı ----
# Genel JSON webhook (Slack/Discord/Mattermost uyumlu "text" alanı da gönderilir). Boş ise kapalı.
ALARM_WEBHOOK_URL=
# Telegram: ikisi birlikte verilmelidir. Boş ise kapalı.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Her alarm ayrıca JSONL olarak bu dosyaya eklenir (compose içinde /app/data/alarms.jsonl).
ALARM_LOG_PATH=data/alarms.jsonl

# ---- Raporlama / API ----
API_HOST=0.0.0.0
API_PORT=8000
REPORT_INTERVAL_MINUTES=60
REPORT_WINDOW_HOURS=24
# q.alarms'tan bu kadar alarm birikince ... veya son özetten bu kadar dakika geçince alarm özeti raporu üret.
REPORT_DIGEST_EVERY=10
REPORT_DIGEST_MINUTES=30
RAG_TOP_K=12
RAG_RECENCY_DAYS=14
